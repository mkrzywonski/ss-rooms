DJANGO_SECRET_KEY=replace-with-a-long-random-value
DB_PASSWORD=replace-with-a-different-long-random-value
# Dedicated random Fernet key; generate securely, keep separate from database backups.
SMTP_ENCRYPTION_KEY=
# Temporary comma-separated retired keys during planned key rotation only.
SMTP_ENCRYPTION_PREVIOUS_KEYS=
PUBLIC_URL=http://localhost:8092
ALLOWED_HOSTS=localhost,127.0.0.1
WEB_PORT=8092
SITE_TIME_ZONE=America/Chicago
# Enable when the HTTPS reverse proxy is ready.
SECURE_COOKIES=false
TRUST_PROXY=false
REGISTRATION_ENABLED=true
INVITATION_REQUIRED=false
# file backend keeps development messages in the private uploads volume.
# For production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=Stellar Skies Lodge <lodge@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
